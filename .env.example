# Configurações do Ambiente ERP Profissional
NODE_ENV=development
PORT=3000

# Banco de dados SQLite (em container utilizar /data/database.sqlite)
DATABASE_URL="file:./dev.db"

# Segurança e Tokens JWT
JWT_SECRET=erp_super_secret_jwt_key_production_2026
JWT_REFRESH_SECRET=erp_super_secret_refresh_jwt_key_production_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# URLs e Diretórios de Persistência
APP_URL=http://localhost:3000
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
LOG_DIR=./data/logs

# Credenciais Iniciais de Seed (Segurança)
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=Admin123456!
